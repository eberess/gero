# OpenAI
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# OVH SMTP
SMTP_SERVER=pro1.mail.ovh.net
SMTP_PORT=587
SMTP_USERNAME=your-email@ovh-domain.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=your-email@ovh-domain.com
SMTP_FROM_NAME=Your Name

# IMAP (pour lire les emails reçus et sauvegarder les envoyés)
# Si non définis, les identifiants SMTP sont utilisés
IMAP_SERVER=pro1.mail.ovh.net
IMAP_PORT=993

# Supabase (recherche contacts intérimaires)
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Database
DB_PATH=/app/data/mailai.db
