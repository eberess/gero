# SMS Gateway (android-sms-gateway)
# Utilise http://sms-gateway:3000 si sur le même réseau Docker
SMS_GATEWAY_URL=http://sms-gateway:3000
SMS_GATEWAY_USERNAME=admin
SMS_GATEWAY_PASSWORD=your_admin_password

# Scopes pour le token JWT (séparés par des virgules)
SMS_SCOPES=messages:send,messages:read,messages:list,devices:list

# Token TTL en secondes (défaut: 3600 = 1h)
SMS_TOKEN_TTL=3600

# Base de données SQLite
DB_PATH=/app/data/gerosms.db
